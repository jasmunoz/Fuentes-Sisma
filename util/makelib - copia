echo "########################## compilo servicios ####################"
alias echo='echo -e'

################################
# directorio
################################

echo "PWD" `pwd`
DIR=""
export DIR
DIR=`pwd | cut -c 1-15`
echo "DIR1" $DIR
export DIR

if [[ $DIR = "/sf/preprod/sf" ]]
then  echo "PREPROD"
      DIR="/sf/preprod/sf"
       export preprod=2
else 
      echo "SF"
      DIR="/sf"
      export preprod=1
fi 
echo "preprod" $preprod
echo "DIR2" $DIR

MP_SISMA=$DIR/sisma
export MP_SISMA

echo "MP_SISMA" $MP_SISMA

MP_MEPA=$DIR/mepa
export MP_MEPA
echo "MP_MEPA" $MP_MEPA

DIRECTORIO=$DIR/tux/include
export DIRECTORIO
echo "DIRECTORIO" $DIRECTORIO

#cada objeto se monta con su fuente y la libreria generica

#$MP_MEPA/rut/obj/filefun.o:$MP_MEPA/rut/src/filefun.cpp

  #precompilar
  echo "dentro del if .cpp" 
  proc   code=ansi_c include=\($ORACLE_HOME/precomp/public/,-I$MP_SISMA/includes,$DIRECTORIO\) iname=$MP_MEPA/rut/src/filefun.cpp oname=$MP_MEPA/rut/src/filefun.c DYNAMIC=ANSI define=__x86_64__
  if [ $? -ne 0 ] ; then
     exit 1
  else
    echo "precompilado" 
  fi

  #compilar

   cc -c -g -m64 -Werror -Wimplicit-function-declaration -lssl -lcrypto -I$DIRECTORIO $MP_MEPA/rut/src/filefun.c -fPIC 

   if [ $? -ne 0 ] ; then
        echo "Error objeto"
        exit 1
   else
     echo "compilado src"
     
     
    cp filefun.o $MP_MEPA/rut/obj/filefun.o
    chmod 777 $MP_MEPA/rut/obj/$1.o
     
    mv filefun.o $MP_SISMA/obj
	chmod 777 $MP_SISMA/obj/filefun.o
    fi


