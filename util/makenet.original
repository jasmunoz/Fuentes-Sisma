echo "########################## compilo servicios ####################"
alias echo='echo -e'

################################
# directorio
################################

echo "PWD" `pwd`
DIR=""
export DIR
DIR=`pwd | cut -c 1-15`
echo "DIR1" $DIR
export DIR

if [[ $DIR = "/sf/preprod/sf" ]]
then  echo "PREPROD"
      DIR="/sf/preprod/sf"
else 
      echo "SF"
      DIR="/sf"
fi 

echo "DIR2" $DIR

MP_SISMA=$DIR/sisma
export MP_SISMA

##################### Defino compilador
DEF_COMUN="-DSUN_OS -DUNIX -DTRAZA=20"
export DEF_COMUN

FUEN_COMUN=$MP_SISMA/src
export FUEN_COMUN

INCLUDES=$MP_SISMA/includes
export INCLUDES
FUENTES=$MP_SISMA/src
export FUENTES

DIRECTORIO=$DIR/tux/include
export DIRECTORIO
echo "DIRECTORIO" $DIRECTORIO

##################### Mueve los ejecutables a carpeta de seguridad
cd $MP_SISMA/exec
for a in `ls | grep -v pmanejTux.sh | grep -v conexhsm.o | grep -v *Tux `; do mv $a $MP_SISMA/copiaexec; done
cd $MP_SISMA/util

##################### compilo servicios 
make -f makepro.mak
err=$?
err=0
if [ $err -ne 0 ]
then
  rm $control
  exit
fi

