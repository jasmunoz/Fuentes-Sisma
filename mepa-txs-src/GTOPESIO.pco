       INICIO-TX.
      *----------
      *    DISPLAY "GTOPESIO V201703 [" AREA-DATOS-SIOAPL "]".
      *    DISPLAY "GTOPESIO AGOSTO 2019 [" AREA-DATOS-SIOAPL "]".      PRJ0105375
      *    DISPLAY "GTOPESIO JUNIO 2020 [" AREA-DATOS-SIOAPL "]".       PRJ0257005
           DISPLAY "GTOPESIO AGOSTO 2023 [" AREA-DATOS-SIOAPL "]".      PRJ0257005
           PERFORM DISPLAY-SIOAPL-ENT THRU FIN-DISPLAY-SIOAPL-ENT.      DMND0035176
      *
      **** MOVE DE PRUEBAS PARA INVERSIS, PRUEBAS DESDE EMULA
      *
      *                                                                 DMND0035176
           DISPLAY "SIOAPL-DAT-ADIC-ENV-TRANSP-L: " 
                                        SIOAPL-DAT-ADIC-ENV-TRANSP-L.
      *                                                                 DMND0035176
           IF    SIOAPL-DAT-ADIC-ENV-TRANSP-L = K4U51                   DMND0035176
           THEN  MOVE  SIOAPL-CODPROC  TO  WK-COD-PROC                  DMND0035176
                 MOVE  K6UREBUT        TO  SIOAPL-CODPROC               DMDN0035176
                 DISPLAY "** PAGO RECIBOS **" 
           ELSE  IF    SIOAPL-DAT-ADIC-ENV-TRANSP-L = K4U07             DMND0035176
                 THEN  MOVE  SIOAPL-CODPROC  TO  WK-COD-PROC            DMND0035176
                       MOVE K6UTRIBUT        TO  SIOAPL-CODPROC         DMND0035176
                       DISPLAY "** PAGO TRIBUTO **"
                 ELSE  NEXT SENTENCE                                    DMND0035176
                 END-IF                                                 DMND0035176
           END-IF.                                                      DMND0035176
      *                                                                 DMND0035176
           MOVE 8                TO   TIPO-ENTRA.
           MOVE  CODIGOTX        TO   IBTXCODE.
           INITIALIZE            AREA-GR-RUTSIO.
      *
       FIN-INICIO-TX.
           EXIT.
      *
      /
       VAL-ENTRADA.
      *------------
      *
      *** move de pruebas mientras llega la clave mac en el
      ***  mensaje de sio
      *
           MOVE  1              TO  SIOAPL-CLAVE-MAC.
      *
           IF    SIN-CLAVE-MAC
                 OR  CLAVE-MAC-1
                 OR  CLAVE-MAC-2
           THEN  NEXT SENTENCE
           ELSE  MOVE CONDB327      TO   DLCOND-NUM
                 PERFORM CONDICION  THRU FIN-CONDICION.
      *
       FIN-VAL-ENTRADA.
           EXIT.
      *
      /
       PROCESO.
      *--------
      *
           DISPLAY "SE INICIA LA EJECUCION DE GTOPESIO".
           DISPLAY "=================================".
           DISPLAY "MODIFICACION PROBAR CIERRE SIO".
      *
035176*    PERFORM INSERTAR-TMEP     THRU FIN-INSERTAR-TMEP.            BUG25291
035176*    PERFORM LLAMAR-GRTRDSIO   THRU FIN-LLAMAR-GRTRDSIO.          PRJ0105375
035176*    IF   NOT IDTM-TX-TOTALES-4B                                  PRJ0105375
035176*    THEN PERFORM ANALIZA-OPEREMI   THRU FIN-ANALIZA-OPEREMI      PRJ0105375
035176*    ELSE PERFORM ACCEDE-DEMI-TOT   THRU FIN-ACCEDE-DEMI-TOT      PRJ0105375
035176*    END-IF.                                                      PRJ0105375
035176*    PERFORM ANALIZ-TIPO-OP    THRU FIN-ANALIZ-TIPO-OP.
035176*    PERFORM MOSTRAR-NUM-AUTOR THRU FIN-MOSTRAR-NUM-AUTOR.
035176*
035176*    display  'gtopesio llamando a salida'.
035176*    PERFORM INSERTAR-TMEP     THRU FIN-INSERTAR-TMEP.            BUG25291
      *                                                                 DMND0035176
           MOVE SPACES               TO   WK-ACCION.                    DMND0035176
      *                                                                 DMND0035176
           MOVE SIOAPL-TOTAL-TELEBANCO(7:1)   TO    FLAG-TRMS.          DMND0035176
           DISPLAY "FLAG-TRMS: " FLAG-TRMS.
      *                                                                 DMND0035176
           IF   NOT IDTM-TEST-SISMA                                     DMND0035176
           AND  SI-TRMS                                                 DMND0035176
           THEN PERFORM INSERTAR-TMEP     THRU FIN-INSERTAR-TMEP        DMND0035176
                PERFORM LLAMAR-GRTRDSIO   THRU FIN-LLAMAR-GRTRDSIO      DMND0035176
      *                                                                 DMND0035176
                IF   NOT IDTM-TX-TOTALES-4B                             DMND0035176
                THEN PERFORM ANALIZA-OPEREMI   THRU FIN-ANALIZA-OPEREMI DMND0035176
                ELSE PERFORM ACCEDE-DEMI-TOT   THRU FIN-ACCEDE-DEMI-TOT DMND0035176
                END-IF                                                  DMND0035176
      *                                                                 DMND0035176
                PERFORM ANALIZ-TIPO-OP    THRU FIN-ANALIZ-TIPO-OP       DMND0035176
                PERFORM MOSTRAR-NUM-AUTOR THRU FIN-MOSTRAR-NUM-AUTOR    DMND0035176
      *                                                                 DMND0035176
                PERFORM INSERTAR-TMEP     THRU FIN-INSERTAR-TMEP        DMND0035176
           ELSE NEXT SENTENCE                                           DMND0035176
           END-IF.                                                      DMND0035176
      *                                                                 DMND0035176
           display  'gtopesio llamando a salida'.                       DMND0035176
      *                                                                 DMND0035176
           IF    SIOAPL-DAT-ADIC-ENV-TRANSP-L = K4U51                   DMND0035176
           OR    SIOAPL-DAT-ADIC-ENV-TRANSP-L = K4U07                   DMND0035176
           THEN  MOVE  WK-COD-PROC     TO  SIOAPL-CODPROC               DMND0035176
           ELSE  NEXT SENTENCE                                          DMND0035176
           END-IF.                                                      DMND0035176
      *                                                                 DMND0035176
           PERFORM SALIDA-TX         THRU FIN-SALIDA-TX.
           PERFORM DISPLAY-SIOAPL-SAL THRU FIN-DISPLAY-SIOAPL-SAL.      DMND0035176
           display 'gtopesio acabo la llamada a salida'.
      *
           DISPLAY 'FIN DE EJECUCION DE GTOPESIO'.
           DISPLAY '============================'.
      *
           ACCEPT WFECHA-AAMMDD      FROM DATE.
           ACCEPT WK-HORA            FROM TIME.

           DISPLAY 'FECHA DE FIN  DE TRATAMIENTO (AAMMDD): '
                                       WFECHA-AAMMDD.
           DISPLAY 'HORA DE FIN DE TRATAMIENTO (HHMMSSDD):'
                                       WK-HORA.
      *
       FIN-PROCESO.
           EXIT.
      *
      /
      * +------------------------------------------------------------+
      * [                                                            ]
      * [           ANALIZAR-TIPO-OP                                 ]
      * [           ---------------                                  ]
      * [                                                            ]
      * [ SI TX-CONTABLE (IDTM 0200 A 0299)  O UNA ANULACION DE TX   ]
      * [   CONTABLE (0400 A 0499) LLAMA A GRCONSIO, EXCEPTO SI EL P2]
      * [   DE LA OPERACION INDICA QUE ES UN  ABONO POR TRANSFERENCIA]
      * [   (  en este caso si las cuentas son del mismo banco envian]
      * [    traspaso (29), si el ordenante es de distinto banco     ]
      * [    envian un codigo de transferencia  (30))                ]
      * [   EN ESTOS CASOS SE LLAMA A GRTRANSIO                      ]
      * [                                                            ]
      * [ SI TX-CONSULTA DE SALDO (IDTM 0700 A 0799) LLAMA A GRCSASIO]
      * [                                                            ]
      * [ SI TX-CONSULTA DE MOV (IDTM 0500 A 5099, 5200 A 5399) LLAMA]
      * [   A GRCUMSIO, EL IDTM INDICA ADEMAS LOS MOVIMIENTOS QUE SE ]
      * [   DEBEN ENVIAR (5 ULTIMOS, 5 PENULTIMOS, 5 ANTEPENULTIMOS) ]
      * [                                                            ]
      * [ SI TX-FUNCION-TRANSPARENTE (IDTM 0600 A 0699) LLAMARA A    ]
      * [  GRFUNSIO ( ESTOS IDTM SE UTILIZAN PARA CAMBIO DE IDIOMA,  ]
      * [  PIN, ETC)                                                 ]
      * [                                                            ]
      * [ SI NO ES NINGUN IDTM VALIDO PARA INVERSIS, SE ENVIARA EN EL]
      * [ P-33 UNA CAUSA 12 (DENEGADA POR PREGUNTA INVALIDA)         ]
      * +------------------------------------------------------------+
      *
       ANALIZ-TIPO-OP.
      ***************
      *
           DISPLAY 'GTOPESIO: TIPO DE MENSAJE (IDTM):' SIOAPL-IDTM.
           DISPLAY 'GTOPESIO: PAN:' SIOAPL-PAN-D.
           ACCEPT WFECHA-AAMMDD    FROM DATE.
           ACCEPT WK-HORA         FROM TIME.

           DISPLAY 'FECHA DE INICIO DE TRATAMIENTO(AAMMDD): '
                                       WFECHA-AAMMDD.
           DISPLAY 'HORA DE INICIO DE TRATAMIENTO (HHMMSSDD):'
                                       WK-HORA.
      *
           MOVE ZEROS                TO   DLCOND-NUM.
           MOVE SPACES               TO   DLCOND-ESTADO.
           MOVE SPACES               TO   RUTSIO-CAUR.
      *
           EVALUATE  TRUE
              WHEN IDTM-TX-CONTABLE
                OR IDTM-ANUL-TX-CONT
                   EVALUATE TRUE
                       WHEN P2-OP-CARGO-TRANSFERENCIA                   PRJ0105375
                            IF    SIOAPL-P32-CSB = DLPEENTICTAS         PRJ0105375
                            THEN  DISPLAY 'GTOPESIO: ES UNA OP CONTABLE'PRJ0105375
                                  DISPLAY 'GTOPESIO: TRANSFERENCIA'     PRJ0105375
                                  DISPLAY 'GTOPESIO: CTAS ENTIDAD'      PRJ0105375
                                  PERFORM CALL-GRCONSIO                 PRJ0105375
                                               THRU  FIN-CALL-GRCONSIO  PRJ0105375
                            ELSE  DISPLAY 'GTOPESIO: TRANSF. EXTERNA'   PRJ0105375
                                  DISPLAY 'SIOAPL-P32-CSB: '
                                                          SIOAPL-P32-CSB
                                  DISPLAY 'DLPEENTICTAS: ' DLPEENTICTAS
                                  MOVE    CONDB321   TO   DLCOND-NUM    PRJ0105375
                                  MOVE    CONDB321   TO   WK-ACCION     PRJ0105375
                                  PERFORM CONDICION  THRU FIN-CONDICION PRJ0105375
                       WHEN P2-OP-ABONO-TRASPASO                        BUG20438
                            AND IDTM-COM-TRAN-CONT                      BUG20438
                            DISPLAY 'GTOPESIO: ES UNA OP CONTABLE'      BUG20438
                            DISPLAY 'GTOPESIO: ES UN ABONO JUEGO ONLINE'BUG20438
                            DISPLAY 'GTOPESIO:VALOR DE COD-PRO (bit 2):'BUG20438
                                               SIOAPL-CODPROC           BUG20438
                            PERFORM CALL-GRCONSIO THRU FIN-CALL-GRCONSIOBUG20438
                       WHEN P2-OP-ABONO-TRASPASO                        BUG20438
                            AND IDTM-ANUL-TX-CONT                       BUG20438
                            AND SIOAPL-SECTOR-JUEGO-ONLINE              BUG20438
                            DISPLAY 'GTOPESIO: ES UNA OP CONTABLE'      BUG20438
                        DISPLAY 'GTOPESIO: ANULACION ABONO JUEGO ONLINE'BUG20438
                            DISPLAY 'GTOPESIO:VALOR DE COD-PRO (bit 2):'BUG20438
                                               SIOAPL-CODPROC           BUG20438
                            PERFORM CALL-GRCONSIO THRU FIN-CALL-GRCONSIOBUG20438
                       WHEN P2-OP-ABONO-TRANSFERENCIA                   
                            OR P2-OP-ABONO-TRASPASO                     
                            DISPLAY 'GTOPESIO: ES UNA TRANSFERENCIA'
                            PERFORM CALL-GRTRASIO THRU FIN-CALL-GRTRASIO
                       WHEN OTHER
                            DISPLAY 'GTOPESIO: ES UNA OP CONTABLE'
                            DISPLAY 'GTOPESIO:VALOR DE COD-PRO (bit 2):'
                                               SIOAPL-CODPROC
                            PERFORM CALL-GRCONSIO THRU FIN-CALL-GRCONSIO
                   END-EVALUATE
              WHEN IDTM-TX-CONSULTA-SALDO
                   DISPLAY 'GTOPESIO: ES CONSULTA SALDO'
                   PERFORM CALL-GRCSASIO THRU FIN-CALL-GRCSASIO
              WHEN IDTM-TX-CONSULTA-MOVIM
                   DISPLAY 'GTOPESIO: ES CONSULTA MOVIMIENTOS'
                   PERFORM CALL-GRCUMSIO THRU FIN-CALL-GRCUMSIO
              WHEN IDTM-TX-FUNCION-TRANSPARENTE
                   DISPLAY 'GTOPESIO: ES CAMBIO IDIOMA O PIN'
                   PERFORM CALL-GRFUNSIO THRU FIN-CALL-GRFUNSIO
              WHEN IDTM-TX-TOTALES-4B
                   DISPLAY 'GTOPESIO: SON TOTALES DE SESION'
                   PERFORM CALL-GRTOTSIO THRU FIN-CALL-GRTOTSIO
              WHEN IDTM-TEST-SISMA                                      DMND0035176
                   DISPLAY 'GTOPESIO: MENSAJE DE TEST DE SISMA'         DMND0035176
                   MOVE  K2X99              TO   SIOAPL-CODRES          DMND0035176
              WHEN OTHER
                   DISPLAY 'GTOPESIO: NINGUN IDTM, BUENO'
                   MOVE   CONDB321        TO   DLCOND-NUM
                   MOVE   CONDB321        TO   WK-ACCION
                   PERFORM CONDICION      THRU FIN-CONDICION
           END-EVALUATE.
      *
      *
       FIN-ANALIZ-TIPO-OP.
           EXIT.
      /
      * +--------------------------------------------------------------+
      * [                          SALIDA-TX                           ]
      * [                          ---------                           ]
      * [COMO AREA DE SALIDA SE UTILIZA LA MISMA QUE EN LA ENTRADA     ]
      * [(LA COPY SIOAPL.LRD).                                         ]
      * +--------------------------------------------------------------+
      *
       SALIDA-TX.
      *----------
      *
           IF    DLVOID
           THEN  DISPLAY 'EN SALIDA-TX POR DLVOID'
                 IF    RUTSIO-ROLLBACK-OK
                 THEN  MOVE  K1XS    TO  NAU-ROLLBACK
                 ELSE  MOVE  K1XN    TO  NAU-ROLLBACK
                 END-IF
                 IF    IDTM-TX-CONSULTA-SALDO
                       OR IDTM-TX-CONSULTA-MOVIM
                       OR IDTM-TX-FUNCION-TRANSPARENTE
                       OR IDTM-TX-TOTALES-4B
                 THEN  MOVE K1XV     TO   NAU-VOID-HNOC
                       GO  TO ENVIO-SALIDA
                 ELSE  GO  TO ENVIO-SALIDA
           ELSE  DISPLAY 'EN SALIDA-TX POR NO VOID'
                 DISPLAY 'RUTSIO-CAUR: ' RUTSIO-CAUR
                 DISPLAY 'WK-ACCION: ' WK-ACCION
                 IF    RUTSIO-CAUR = SPACES
                 THEN  IF    WK-ACCION  = SPACES
                       THEN  PERFORM PREP-SAL-AUTOR
                                    THRU FIN-PREP-SAL-AUTOR
                       ELSE  MOVE  WK-ACCION    TO   DLCOND-NUM
                             MOVE  K1XN         TO   NAU-ROLLBACK
                             PERFORM CONDICION  THRU FIN-CONDICION
                 ELSE  MOVE  RUTSIO-CAUR        TO   DLCOND-NUM
                       MOVE  K1XN               TO   NAU-ROLLBACK
                       PERFORM CONDICION        THRU FIN-CONDICION.
      *
           PERFORM CALCULAR-MAC         THRU  FIN-CALCULAR-MAC.
      *
           DISPLAY 'AREA-DATOS-SIOAPL(1:200)'
                                       AREA-DATOS-SIOAPL(1:200).
           DISPLAY 'AREA-DATOS-SIOAPL(201:200)'
                                       AREA-DATOS-SIOAPL(201:200).
           DISPLAY 'AREA-DATOS-SIOAPL(401:200)'
                                       AREA-DATOS-SIOAPL(401:200).
           DISPLAY 'AREA-DATOS-SIOAPL(601:200)'
                                       AREA-DATOS-SIOAPL(601:200).
           DISPLAY 'AREA-DATOS-SIOAPL(801:200)'
                                       AREA-DATOS-SIOAPL(801:200).
           DISPLAY 'AREA-DATOS-SIOAPL(1001:200)'
                                       AREA-DATOS-SIOAPL(1001:200).
           DISPLAY 'AREA-DATOS-SIOAPL(1201:200)'
                                       AREA-DATOS-SIOAPL(1201:200).
           DISPLAY 'AREA-DATOS-SIOAPL(1401:200)'
                                       AREA-DATOS-SIOAPL(1401:200).
           DISPLAY 'AREA-DATOS-SIOAPL(1601:200)'
                                       AREA-DATOS-SIOAPL(1601:200).
           DISPLAY 'AREA-DATOS-SIOAPL(1701:200)'
                                       AREA-DATOS-SIOAPL(1801:200).
           DISPLAY 'AREA-DATOS-SIOAPL(2001:200)'
                                       AREA-DATOS-SIOAPL(2001:200).
           DISPLAY 'AREA-DATOS-SIOAPL(2201:200)'
                                       AREA-DATOS-SIOAPL(2201:200).
           DISPLAY 'AREA-DATOS-SIOAPL(2401:200)'
                                       AREA-DATOS-SIOAPL(2401:200).
           DISPLAY 'AREA-DATOS-SIOAPL(2601:200)'
                                       AREA-DATOS-SIOAPL(2601:200).
           DISPLAY 'AREA-DATOS-SIOAPL(2801:200)'
                                       AREA-DATOS-SIOAPL(2801:200).
           DISPLAY 'AREA-DATOS-SIOAPL(3001:200)'
                                       AREA-DATOS-SIOAPL(3001:200).
           DISPLAY 'AREA-DATOS-SIOAPL(3201:200)'
                                       AREA-DATOS-SIOAPL(3201:200).
           DISPLAY 'AREA-DATOS-SIOAPL(3401:200)'
                                       AREA-DATOS-SIOAPL(3401:200).
           DISPLAY 'AREA-DATOS-SIOAPL(3601:200)'
                                       AREA-DATOS-SIOAPL(3601:200).
      *
           MOVE AREA-DATOS-SIOAPL       TO    WK-AREA-DATOS-SIOAPL.
      *
           DISPLAY 'WK-AREA-DATOS-SIOAPL(1:200)'
                                       WK-AREA-DATOS-SIOAPL(1:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(201:200)'
                                       WK-AREA-DATOS-SIOAPL(201:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(401:200)'
                                       WK-AREA-DATOS-SIOAPL(401:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(601:200)'
                                       WK-AREA-DATOS-SIOAPL(601:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(801:200)'
                                       WK-AREA-DATOS-SIOAPL(801:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(1001:200)'
                                       WK-AREA-DATOS-SIOAPL(1001:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(1201:200)'
                                       WK-AREA-DATOS-SIOAPL(1201:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(1401:200)'
                                       WK-AREA-DATOS-SIOAPL(1401:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(1601:200)'
                                       WK-AREA-DATOS-SIOAPL(1601:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(1701:200)'
                                       WK-AREA-DATOS-SIOAPL(1801:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(2001:200)'
                                       WK-AREA-DATOS-SIOAPL(2001:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(2201:200)'
                                       WK-AREA-DATOS-SIOAPL(2201:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(2401:200)'
                                       WK-AREA-DATOS-SIOAPL(2401:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(2601:200)'
                                       WK-AREA-DATOS-SIOAPL(2601:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(2801:200)'
                                       WK-AREA-DATOS-SIOAPL(2801:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(3001:200)'
                                       WK-AREA-DATOS-SIOAPL(3001:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(3201:200)'
                                       WK-AREA-DATOS-SIOAPL(3201:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(3401:200)'
                                       WK-AREA-DATOS-SIOAPL(3401:200).
           DISPLAY 'WK-AREA-DATOS-SIOAPL(3601:200)'
                                       WK-AREA-DATOS-SIOAPL(3601:200).
      *
           PERFORM SALIDA-TABLA-TPOS  THRU FIN-SALIDA-TABLA-TPOS.
      *
       FIN-SALIDA-TX.
           EXIT.
      /
      * +--------------------------------------------------------------+
      * [                        PREP-SAL-AUTOR                        ]
      * [                        --------------                        ]
      * +--------------------------------------------------------------+
      *
       PREP-SAL-AUTOR.
      *---------------
      *
           display 'salida autorizada de opersio'.
           IF    IDTM-TEST-SISMA                                        DMND0035176
           THEN  MOVE  K2X99        TO   SIOAPL-CODRES                  DMND0035176
           ELSE  IF    NO-TRMS                                          DMND0035176
                 THEN  MOVE K2X76   TO   SIOAPL-CODRES                  DMND0035176
                 ELSE                                                   DMND0035176
           MOVE  K2X01              TO   SIOAPL-CODRES.
      *
       FIN-PREP-SAL-AUTOR.
      *-------------------
           EXIT.
      *
      * +--------------------------------------------------------------+
      * [                        PREP-SAL-DENEG                        ]
      * [                        --------------                        ]
      * +--------------------------------------------------------------+
      *
       PREP-SAL-DENEG.
      *---------------
      *
           display 'salida denegada en opesio'.
           PERFORM CONVERTIR-MOTERR THRU FIN-CONVERTIR-MOTERR.
      *
       FIN-PREP-SAL-DENEG.
      *-------------------
           EXIT.
      *
      * +--------------------------------------------------------------+
      * [                       CONVERTIR-MOTERR                       ]
      * [                       ----------------                       ]
      * +--------------------------------------------------------------+
      *
       CONVERTIR-MOTERR.
      *-----------------
      *
      ***l     display 'gtopesio llamando a tabconsio'.
           PERFORM LEER-TABCONDSIO     THRU FIN-LEER-TABCONDSIO.
      *
           MOVE WK-ACC-RES             TO   SIOAPL-CODRES.
      *
      *
       FIN-CONVERTIR-MOTERR.
      *---------------------
           EXIT.
      /
      *
       CALCULAR-MAC.
      **************
      *
          IF    SIN-CLAVE-MAC
          THEN  MOVE K1U0              TO    SIOAPL-CLAVE-MAC
                MOVE SPACES            TO    SIOAPL-MAC-X
          ELSE  IF    IDTM-PET-TRAN-CONT
                      OR  IDTM-COM-TRAN-CONT
                      OR  IDTM-ANUL-TRAN-CONT
                      OR  IDTM-SOL-ABN-TRANSF-TRASP
                      OR  IDTM-PET-FUN-TRANSPARENTE
                      OR  IDTM-COM-FUN-TRANSPARENTE
                THEN  PERFORM MONTAR-DATOS-MAC
                              THRU FIN-MONTAR-DATOS-MAC
                      PERFORM CALL-GRCALMAC    THRU FIN-CALL-GRCALMAC
                      PERFORM DECIMALIZAR-MAC  THRU FIN-DECIMALIZAR-MAC
                      MOVE   WK-AUX-RES-MAC-R  TO   SIOAPL-MAC
                ELSE  MOVE K1U0                TO   SIOAPL-CLAVE-MAC
                      MOVE SPACES              TO   SIOAPL-MAC-X.
      *
       FIN-CALCULAR-MAC.
           EXIT.
      *
       MONTAR-DATOS-MAC.
      *****************
      *
           IF    IDTM-PET-TRAN-CONT
                 OR  IDTM-COM-TRAN-CONT
                 OR  IDTM-ANUL-TRAN-CONT
           THEN  MOVE SIOAPL-PAN-D (1:16)        TO  MAC-200-PAN
                 MOVE SIOAPL-IMPORTX-X           TO  MAC-200-IMP
LKMOVE*          MOVE SIOAPL-IDTR                TO  MAC-200-IDTR
LKMOVE           MOVE SIOAPL-IDTR(1:) TO MAC-200-IDTR(1:)
                 MOVE SIOAPL-CMONTI              TO  MAC-200-CMON
                 MOVE SIOAPL-CODRES              TO  MAC-200-RESP
                 MOVE SIOAPL-NUMAUT              TO  MAC-200-NAUT
LKMOVE*          MOVE SIOAPL-CLAVE-MAC           TO  MAC-200-CLAV
LKMOVE           MOVE SIOAPL-CLAVE-MAC(1:) TO MAC-200-CLAV(1:)
                 MOVE LOW-VALUES                 TO  MAC-200-FILL
           ELSE  IF    IDTM-SOL-ABN-TRANSF-TRASP
                 THEN  MOVE SIOAPL-IMPOROP       TO  MAC-260-IMP
LKMOVE*                MOVE SIOAPL-IDTR          TO  MAC-260-IDTR
LKMOVE                 MOVE SIOAPL-IDTR(1:) TO MAC-260-IDTR(1:)
                       MOVE SIOAPL-CMONTI        TO  MAC-260-CMON
                       MOVE SIOAPL-CODRES        TO  MAC-260-RESP
                       MOVE SIOAPL-NUMAUT        TO  MAC-260-NAUT
                       MOVE SIOAPL-NUMAUT        TO  MAC-260-CLAV
                       MOVE LOW-VALUES           TO  MAC-260-FILL
                 ELSE  MOVE SIOAPL-PAN-D (1:16)  TO  MAC-600-PAN
LKMOVE*                MOVE SIOAPL-IDTR          TO  MAC-600-IDTR
LKMOVE                 MOVE SIOAPL-IDTR(1:) TO MAC-600-IDTR(1:)
                       MOVE SIOAPL-CODRES        TO  MAC-600-RESP
                       MOVE SIOAPL-NUMAUT        TO  MAC-600-NAUT
LKMOVE*                MOVE SIOAPL-CLAVE-MAC     TO  MAC-600-CLAV
LKMOVE                 MOVE SIOAPL-CLAVE-MAC(1:) TO MAC-600-CLAV(1:)
                       MOVE LOW-VALUES           TO  MAC-600-FILL.
      *
LKMOVE*    MOVE  SIOAPL-CLAVE-MAC          TO   IND-MAC.
LKMOVE     MOVE SIOAPL-CLAVE-MAC(1:) TO IND-MAC(1:).
           MOVE  DATOS-MAC                 TO   MEM-MAC.
      *
       FIN-MONTAR-DATOS-MAC.
           EXIT.
      *
       DECIMALIZAR-MAC.
      *****************
      *
           MOVE  RES-MAC                 TO   WK-AUX-MAC.
      *
           MOVE  K1U0                    TO   WI-IND-DAT-MAC.
           MOVE  K1U0                    TO   WI-IND-RES-MAC.
      *
           PERFORM OBT-RES-MAC           THRU FIN-OBT-RES-MAC
                   UNTIL  MAX-IND-RES-MAC
                          OR  MAX-IND-DAT-MAC.
      *
           IF    MAX-IND-RES-MAC
           THEN  NEXT SENTENCE
           ELSE  MOVE  K1U0             TO   WI-IND-DAT-MAC
                 PERFORM OBT-RES-MAC    THRU FIN-OBT-RES-MAC
                         UNTIL  MAX-IND-RES-MAC.
      *
       FIN-DECIMALIZAR-MAC.
           EXIT.
      *
       OBT-RES-MAC.
      *************
      *
           ADD   K1U1                   TO   WI-IND-DAT-MAC.
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) IS NUMERIC
           THEN  ADD   K1U1    TO  WI-IND-RES-MAC
                 MOVE  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
                               TO  WK-AUX-ELEM-RES-MAC(WI-IND-RES-MAC)
                 MOVE  K1XAST  TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  PERFORM CONV-LETRA    THRU FIN-CONV-LETRA.
      *
       FIN-OBT-RES-MAC.
           EXIT.
      *
       CONV-LETRA.
      ************
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) = K2X3A
           THEN  MOVE  K1U0       TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  NEXT SENTENCE.
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) = K2X3B
           THEN  MOVE  K1U1       TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  NEXT SENTENCE.
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) = K2X3C
           THEN  MOVE  K1U2       TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  NEXT SENTENCE.
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) = K2X3D
           THEN  MOVE  K1U3       TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  NEXT SENTENCE.
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) = K2X3E
           THEN  MOVE  K1U4       TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  NEXT SENTENCE.
      *
           IF    WK-AUX-ELEM-MAC (WI-IND-DAT-MAC) = K2X3F
           THEN  MOVE  K1U5       TO  WK-AUX-ELEM-MAC (WI-IND-DAT-MAC)
           ELSE  NEXT SENTENCE.
      *
       FIN-CONV-LETRA.
           EXIT.
      * +--------------------------------------------------------------+
      * [                      SALIDA-TABLA-TPOS                       ]
      * [                      -----------------                       ]
      * +--------------------------------------------------------------+
      *
       SALIDA-TABLA-TPOS.
      *------------------
      *
           MOVE DLPT-LENGUA            TO   DLCODIGO-LENG.
      *
           PERFORM SAL-FMTZT0925       THRU FIN-SAL-FMTZT0925
               VARYING  IND
                  FROM  1  BY  1
                 UNTIL  IND > 25.
      *
           PERFORM SAL-FMTZT0926       THRU FIN-SAL-FMTZT0926.
      *
       FIN-SALIDA-TABLA-TPOS.
           EXIT.
      *
      /
      * +------------------------------------------------------------+
      * [                                                            ]
      * [           SALIDAS DE LA TRANSACCION                        ]
      * [           --------------------------                       ]
      * +------------------------------------------------------------+
      *
       SAL-FMTZT0925.
      *--------------
      *
           MOVE  FMTZT0925             TO   DLNUM-FORMATO.
           MOVE  WK-TPO-DE-143 (IND)   TO   DLTEXTO-MSG.
           DISPLAY "WK-TPO-DE-143(" IND "): " WK-TPO-DE-143 (IND).
           PERFORM LLAMADA-SALIDA      THRU FIN-LLAMADA-SALIDA.
      *
       FIN-SAL-FMTZT0925.
           EXIT.
      *
      *
       SAL-FMTZT0926.
      *--------------
      *
           MOVE  FMTZT0926           TO   DLNUM-FORMATO.
           MOVE  WK-TPO-DE-121       TO   DLTEXTO-MSG.
           DISPLAY "WK-TPO-DE-121: " WK-TPO-DE-121. 
           PERFORM LLAMADA-SALIDA    THRU FIN-LLAMADA-SALIDA.
      *
       FIN-SAL-FMTZT0926.
           EXIT.
      *
      * +--------------------------------------------------------------+
      * [                           SALIDA-T                           ]
      * [                           --------                           ]
      * +--------------------------------------------------------------+
      *
       SALIDA-T.
      *---------
      *
           MOVE FMTZT0937              TO          DLNUM-FORMATO.
           MOVE 'T'                    TO          DLTEXTO-MSG.
           PERFORM LLAMADA-SALIDA    THRU FIN-LLAMADA-SALIDA.
      *
       FIN-SALIDA-T.
      *-------------
           EXIT.
      /
      * +--------------------------------------------------------------+
      * [                        -------------                         ]
      * [                        ACCESOS A PDU                         ]
      * [                        -------------                         ]
      * +--------------------------------------------------------------+
      *
      * +--------------------------------------------------------------+
      * [                       LEER-TABCONDSIO                        ]
      * [                       ---------------                        ]
      * +--------------------------------------------------------------+
      *
       LEER-TABCONDSIO.
      *----------------
      *
           MOVE WK-AUX-SIOCAUR         TO    CSIO-CLAV-1.
           MOVE SPACES                 TO    CSIO-CLAV-2.
           MOVE SPACES                 TO    CSIO-CLAV-3.
           MOVE CLAV-CONDSIO           TO    INFO-CLADATO.
           display 'valor de error, condsio:' CLAV-CONDSIO.
      *
           MOVE NTABTABCONDSIO         TO    INFO-TABLA.
           MOVE ZEROES                 TO    INFO-CLAINST.
           MOVE ZERO                   TO    INFO-CONT.
           MOVE K3U102                 TO    INFO-VLI.
      *
           PERFORM CALL-PDU            THRU  FIN-CALL-PDU.
      *
           EVALUATE TRUE
               WHEN DLBUEN-ACCESO
                    MOVE INFO-DATOS    TO    DATOS-TABCONDSIO
                    MOVE CSIOCACC      TO    WK-ACC-RES
               WHEN DLNOT-DATA
                    MOVE WC-ER-DEFECTO TO    WK-ACC-RES
               WHEN OTHER
                    MOVE COND0301      TO    DLCOND-NUM
                    MOVE 2             TO    DLDISPLA-TIPERR
                    MOVE K1XN          TO    NAU-ROLLBACK
                    PERFORM DISPLAYAR  THRU  FIN-DISPLAYAR
                    PERFORM CONDICION  THRU  FIN-CONDICION
           END-EVALUATE.
      *
       FIN-LEER-TABCONDSIO.
      *--------------------
           EXIT.
      /
      * +--------------------------------------------------------------+
      * [                       MOSTRAR-NUM-AUTOR                      ]
      * [                       -----------------                      ]
      * +--------------------------------------------------------------+
      *
       MOSTRAR-NUM-AUTOR.
      *------------------
      *
           MOVE SPACES            TO BDISPL-TEXTO.
      *
           STRING MENSAJE1,
                  SIOAPL-NUMAUT
                  MENSAJE2,
                  SIOAPL-IDTR    DELIMITED BY '  '
                                      INTO BDISPL-TEXTO.
      *
           MOVE K1XI             TO BDISPL-TIPOMENS.
      *
           PERFORM CALL-GRBDISPL  THRU FIN-CALL-GRBDISPL.
      *
       FIN-MOSTRAR-NUM-AUTOR.
      *----------------------
           EXIT.
      *                                                                 PRJ0105375
       ANALIZA-OPEREMI.                                                 PRJ0105375
      *****************                                                 PRJ0105375
      *                                                                 PRJ0105375
           DISPLAY "ANALIZA-OPEREMI".
           MOVE  SPACES                TO  AREA-GRTRDEMI.               PRJ0105375
           MOVE  SIOAPL-PAN-D (1:18)   TO  WK-PAN-18.                   PRJ0105375
           MOVE  WK-PAN-16             TO  RDEMI-NTAR.                  PRJ0105375
           DISPLAY "RDEMI-NTAR: " RDEMI-NTAR.
      *                                                                 PRJ0105375
           PERFORM CALL-GRTRDEMI       THRU FIN-CALL-GRTRDEMI.          PRJ0105375
      *                                                                 PRJ0105375
           DISPLAY "RDEMI-SALIDA: " RDEMI-SALIDA.
           EVALUATE TRUE                                                PRJ0105375
               WHEN RDEMIST-OK                                          PRJ0105375
                    MOVE  RDEMI-CTAO   TO    GRTRDEMI-CTA-EMISOR        PRJ0105375
                    PERFORM  VALIDA-OPEREMI  THRU FIN-VALIDA-OPEREMI    PRJ0105375
               WHEN OTHER                                               PRJ0105375
                    MOVE CONDB321      TO    DLCOND-NUM                 PRJ0105375
                    MOVE 2             TO    DLDISPLA-TIPERR            PRJ0105375
                    MOVE K1XN          TO    NAU-ROLLBACK               PRJ0105375
                    PERFORM DISPLAYAR  THRU  FIN-DISPLAYAR              PRJ0105375
                    PERFORM CONDICION  THRU  FIN-CONDICION              PRJ0105375
           END-EVALUATE.                                                PRJ0105375
      *                                                                 PRJ0105375
       FIN-ANALIZA-OPEREMI.                                             PRJ0105375
      *********************                                             PRJ0105375
      *                                                                 PRJ0105375
           EXIT.                                                        PRJ0105375
      *                                                                 PRJ0105375
       VALIDA-OPEREMI.                                                  PRJ0105375
      ****************                                                  PRJ0105375
      *                                                                 PRJ0105375
           DISPLAY "VALIDA-OPEREMI".
           MOVE  SPACES                TO  CLAVE-TABOPEREMI.            PRJ0105375
           MOVE  RDEMI-CEMI            TO  OPEREM-EMISOR                PRJ0105375
                                           GRTRDEMI-EMISOR.             PRJ0105375
           MOVE  K1XO                  TO  OPEREM-TIPO.                 PRJ0105375
           MOVE  SIOAPL-IDTM           TO  OPEREM-IDTM.                 PRJ0105375
           MOVE  SIOAPL-OPERACION      TO  OPEREM-OPER.                 PRJ0105375
      *                                                                 PRJ0105375
           MOVE CLAVE-TABOPEREMI       TO    INFO-CLADATO.              PRJ0105375
           DISPLAY "CLAVE TABOPEREMI: " CLAVE-TABOPEREMI.               PRJ0105375
      *                                                                 PRJ0105375
           MOVE NTABTABOPEREMI         TO    INFO-TABLA.                PRJ0105375
           MOVE ZEROES                 TO    INFO-CLAINST.              PRJ0105375
           MOVE ZERO                   TO    INFO-CONT.                 PRJ0105375
           MOVE K3U102                 TO    INFO-VLI.                  PRJ0105375
      *                                                                 PRJ0105375
           PERFORM CALL-PDU            THRU  FIN-CALL-PDU.              PRJ0105375
      *                                                                 PRJ0105375
           EVALUATE TRUE                                                PRJ0105375
               WHEN DLBUEN-ACCESO                                       PRJ0105375
                    MOVE INFO-DATOS    TO    DATOS-TABOPEREMI           PRJ0105375
                    DISPLAY "DATOS-TABOPEREMI: " DATOS-TABOPEREMI       PRJ0105375
                    IF   OPEREM-VALI = K2XOK                            PRJ0105375
                    THEN NEXT SENTENCE                                  PRJ0105375
                    ELSE MOVE CONDB321 TO    DLCOND-NUM                 PRJ0105375
                         MOVE 2        TO    DLDISPLA-TIPERR            PRJ0105375
                         MOVE K1XN     TO    NAU-ROLLBACK               PRJ0105375
                         PERFORM DISPLAYAR  THRU  FIN-DISPLAYAR         PRJ0105375
                         PERFORM CONDICION  THRU  FIN-CONDICION         PRJ0105375
                    END-IF                                              PRJ0105375
               WHEN OTHER                                               PRJ0105375
                    MOVE CONDB321      TO    DLCOND-NUM                 PRJ0105375
                    MOVE 2             TO    DLDISPLA-TIPERR            PRJ0105375
                    MOVE K1XN          TO    NAU-ROLLBACK               PRJ0105375
                    PERFORM DISPLAYAR  THRU  FIN-DISPLAYAR              PRJ0105375
                    PERFORM CONDICION  THRU  FIN-CONDICION              PRJ0105375
           END-EVALUATE.                                                PRJ0105375
      *                                                                 PRJ0105375
       FIN-VALIDA-OPEREMI.                                              PRJ0105375
      ********************                                              PRJ0105375
      *                                                                 PRJ0105375
           EXIT.                                                        PRJ0105375
      *                                                                 PRJ0105375
       ACCEDE-DEMI-TOT.                                                 PRJ0105375
      *----------------                                                 PRJ0105375
      *                                                                 PRJ0105375
           DISPLAY "GTOPESIO - SIOAPL-IDE-CD: " SIOAPL-IDE-CD.
           MOVE SIOAPL-IDE-CD(2:1)     TO   DEMINR4B DEMINRMC DEMINRVI  PRJ0105375
                                            DEMIPRIC.                   DMND0035176
      *                                                                 PRJ0105375
           EXEC SQL                                                     PRJ0105375
                SELECT  DEMIEMIS                                        PRJ0105375
                  INTO :DEMIEMIS                                        PRJ0105375
                  FROM  DEMI                                            PRJ0105375
                 WHERE  DEMINR4B = :DEMINR4B                            PRJ0105375
                    OR  DEMINRMC = :DEMINRMC                            PRJ0105375
                    OR  DEMINRVI = :DEMINRVI                            PRJ0105375
                    OR  DEMIPRIC = :DEMIPRIC                            DMND0035176
           END-EXEC.                                                    PRJ0105375
      *                                                                 PRJ0105375
           PERFORM CAMB-STAT-ORA       THRU FIN-CAMB-STAT-ORA.          PRJ0105375
      *                                                                 PRJ0105375
           IF    DLBUEN-ACCESO                                          PRJ0105375
           THEN  MOVE  DEMIEMIS        TO  GRTRDEMI-EMISOR              PRJ0105375
                 DISPLAY "GTOPESIO - TOTALES - DEMIEMIS: " DEMIEMIS
           ELSE  DISPLAY "GTOPESIO->ERROR-LEER-DEMI|"                   PRJ0105375
                 DEMINR4B "|" SQLCODE "]"                               PRJ0105375
                 MOVE CONDB321         TO    DLCOND-NUM                 PRJ0105375
                 MOVE 2                TO    DLDISPLA-TIPERR            PRJ0105375
                 MOVE K1XN             TO    NAU-ROLLBACK               PRJ0105375
                 PERFORM DISPLAYAR     THRU  FIN-DISPLAYAR              PRJ0105375
                 PERFORM CONDICION     THRU  FIN-CONDICION              PRJ0105375
           END-IF.                                                      PRJ0105375
      *                                                                 PRJ0105375
       FIN-ACCEDE-DEMI-TOT.                                             PRJ0105375
      *--------------------                                             PRJ0105375
      *                                                                 PRJ0105375
           EXIT.                                                        PRJ0105375
