       LEER-TMEP.                                                       BUG25291
      *----------                                                       BUG25291
           MOVE SIOAPL-IDTR(1:)        TO WK-RTS-IDTR(1:).              BUG25291
           MOVE SIOAPL-FECHAL(1:)      TO WK-RTS-FECHAL(1:).            BUG25291
           MOVE SIOAPL-HORAL(1:)       TO WK-RTS-HORAL(1:).             BUG25291
           MOVE SIOAPL-ID-REDTERM      TO WK-RTS-IDTERM.                BUG25291
           MOVE WK-RTS                 TO TMEPCLAV.                     BUG25291
           DISPLAY 'GTOPESIO-> LEER-TMEP:' TMEPCLAV.
      *                                                                 BUG25291       
           EXEC SQL                                                     BUG25291
                SELECT NVL(MAX(TMEPSECU),0)                             BUG25291
                 INTO :TMEPSECU                                         BUG25291
                 FROM TMEP                                              BUG25291
                WHERE TMEPCLAV = :TMEPCLAV                              BUG25291
           END-EXEC.                                                    BUG25291
      *                                                                 BUG25291
           PERFORM CAMB-STAT-ORA    THRU FIN-CAMB-STAT-ORA.             BUG25291
      *                                                                 BUG25291
           IF    DLBUEN-ACCESO                                          BUG25291
           THEN  ADD K1U1 TO TMEPSECU                                   BUG25291
           ELSE  DISPLAY "GTOPESIO->ERROR-LEER-TMEP|"                   BUG25291
                 TMEPCLAV "|" SQLCODE "]"                               BUG25291
           END-IF.                                                      BUG25291
                                                                        BUG25291
       FIN-LEER-TMEP.                                                   BUG25291
           EXIT.                                                        BUG25291
                                                                        BUG25291
                                                                        BUG25291
       INSERTAR-TMEP.                                                   BUG25291                     
      *--------------                                                   BUG25291
           PERFORM LEER-TMEP           THRU FIN-LEER-TMEP.              BUG25291
      *                                                                 BUG25291
           MOVE SPACES                 TO   TMEPMENS.                   BUG25291
           MOVE AREA-DATOS-SIOAPL      TO   TMEPMENS.                   BUG25291
           DISPLAY 'GTOPESIO-> INSERTAR-TMEP:' TMEPMENS.
           MOVE DLFECHAEQ              TO   TMEPFEEQ.                   BUG25291
      *                                                                 BUG25291
           EXEC SQL                                                     BUG25291
            INSERT INTO TMEP VALUES (                                   BUG25291
                    :TMEPCLAV, :TMEPSECU, :TMEPMENS, :TMEPFEEQ          BUG25291
            )                                                           BUG25291
           END-EXEC.                                                    BUG25291
      *                                                                 BUG25291
           PERFORM CAMB-STAT-ORA    THRU FIN-CAMB-STAT-ORA.             BUG25291
      *                                                                 BUG25291
           IF    DLBUEN-ACCESO                                          BUG25291
           THEN  NEXT  SENTENCE                                         BUG25291
           ELSE  DISPLAY 'GTOPESIO-> TMEPFEEQ ' TMEPFEEQ
                 DISPLAY "GTOPESIO->ERROR-INSERT-TMEP|"                 BUG25291
                 TMEPCLAV "|" SQLCODE "]"                               BUG25291
           END-IF.                                                      BUG25291
      *                                                                 BUG25291
       FIN-INSERTAR-TMEP.                                               BUG25291  
           EXIT.                                                        BUG25291
                                                                        BUG25291
