      ******************************************************************
      *
      * GRUPO PAR-MPX2005(PMPXHSM0)
      *
      *
      ******************************************************************
       01  PMPXHSM0.
           02 MPXHSM0                      PIC X(8)
                                           VALUE 'SMPXHSM0'.
              88 PROGRAMA-VALIDO           VALUE 'SMPXHSM0'.
           02 EMPXHSM0.
             04 CPRCSO                     PIC XX
                                           VALUE SPACES.
              88 ABRIR-HSM                 VALUE '01'.
              88 OBTENER-CLAVES            VALUE '02'.
              88 OBTENER-VALOR             VALUE '03'.
              88 CERRAR-HSM                VALUE '04'.
              88 TODO                      VALUE '05'.
             04 NUEMPRCE                   PIC X(04)
                                           VALUE SPACES.
             04 COMANDO                    PIC X(50)
                                           VALUE SPACES.
             04 COMANDO-TRAD               PIC X(02) 
                                           VALUE SPACES.
              88 CIFRADO-DATO-TRAD         VALUE '14'.
              88 DESCIFRADO-DATO-TRAD      VALUE '15'.
              88 CIFRADO-TXT-TRAD          VALUE '17'.
              88 DESCIFRADO-TXT-TRAD       VALUE '18'.
              88 HASHEADO-TRAD             VALUE '30'.
              88 RSA-TRAD                  VALUE '31'.
              88 CIFRADO-FICH-TRAD         VALUE '33'.                   PRJ0232881
              88 DESCIFRADO-FICH-TRAD      VALUE '34'.                   PRJ0232881
              
             04 NUSOCKET                   PIC X(20)
                                           VALUE SPACES.
             04 CDESTINO                   PIC X(04)
                                           VALUE SPACES.
             04 CBIN                       PIC X(06)
                                           VALUE '000000'.
             04 NULONGVA                   PIC 9(04)
                                           VALUE ZEROES.
             04 TIMEOUT-E                  PIC X(04)
                                           VALUE SPACES.
             04 TCLAVES                    PIC X(160)
                                           VALUE SPACES.
             04 TVALOR                     PIC X(1500)
                                           VALUE SPACES.
           02 SMPXHSM0.
             04 TRTRNO                     PIC X(100)
                                           VALUE 'ERROR EN LLAMADA'.
             04 CRTRNO                     PIC XX
                                           VALUE '99'.
              88 OK-SMPXHSM0               VALUE '01'.
              88 ERROR-IMPREVISTO          VALUE '02'.
              88 ERROR-PREVISTO            VALUE '03'.
              88 ERROR-PREVISTO-ROLLBACK   VALUE '04'.
             04 CRSPSTA                    PIC XX
                                           VALUE SPACES.
              88 CORRECTO                  VALUE '01'.
              88 DATOS-ENTRADA-ERRONEOS    VALUE '02'.
              88 ERROR-COMUNICACION        VALUE '03'.
              88 OTRO-ERROR-HSM            VALUE '04'.
             04 CSQLCODE                   PIC -99999
                                           VALUE SPACES.
             04 NUMNSJE                    PIC X(08)
                                           VALUE SPACES.
             04 NUSOCKET-S                 PIC X(20)
                                           VALUE SPACES.
             04 TIMEOUT-S                  PIC X(04)
                                           VALUE SPACES.
             04 TCLAVES-S1                 PIC X(160)
                                           VALUE SPACES.
             04 TCLAVES-S2                 PIC X(160)
                                           VALUE SPACES.
             04 TVALOR-S                   PIC X(3000)
                                           VALUE SPACES.
