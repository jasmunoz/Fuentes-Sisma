003230*   <------------------------
003240*   <------------------------
003250    ELSE  IF    CAL-NA-VISA
003260          THEN  PERFORM CALCULA-NA-VISA THRU FIN-CALCULA-NA-VISA
003270          ELSE  IF    CAL-CVV
003280                THEN  PERFORM CALCULO-CVV THRU FIN-CALCULO-CVV
003290                ELSE  IF    CAL-PA-1
003300                      THEN  PERFORM CALCULO-PA1
003310                               THRU FIN-CALCULO-PA1
                            ELSE   IF    CAMBIO-BL-PIN                  EURO6000
                                   THEN  PERFORM VAL-Y-CAMBIO-BLOQ-PIN  EURO6000
                                         THRU FIN-VAL-Y-CAMBIO-BLOQ-PIN EURO6000
      *   <------------------------                                     CSSSGM
      *   <------------------------                                     CSSSGM
      *   <------------------------                                     CSSSGM
          ELSE  IF    VAL-CSS-CVC-CVV                                   CSSSGM
                THEN  PERFORM VALI-CSS-CVC-CVV THRU FIN-VALI-CSS-CVC-CVVCSSSGM
                ELSE  IF    CAL-OFFSET                                  SAL92320
                      THEN  PERFORM CALCULO-OFFSET                      SAL92320
                               THRU FIN-CALCULO-OFFSET                  SAL92320
                      ELSE  IF    CAL-OFFSET-2                          PRJ0144187
      *                     THEN  PERFORM  CALCULO-OFFSET-PIN-CLARO     PRJ0211439
                            THEN  PERFORM VOY-A-XOR                     PRJ0211439      
                                       THRU FIN-VOY-A-XOR               PRJ0211439
                                  PERFORM  CALCULO-OFFSET-PIN-CLARO     PRJ0211439
                                     THRU  FIN-CALCULO-OFFSET-PIN-CLARO PRJ0144187
                            ELSE  IF    CAL-PIN-ISO0                    PRJ0144187
                                  THEN  PERFORM  CALCULO-PIN-ISO0       PRJ0144187
                                           THRU  FIN-CALCULO-PIN-ISO0   PRJ0144187
                                  ELSE  MOVE 'ERCO'  TO RUTDES-RESULT.  SAL92320
003330*
003340 FIN-RUTINA.
003350     EXIT PROGRAM.
003360*
003370*    ELECCION DE CLAVES SEGUN EL BIN DE LA TARJETA
003380*
003390 VER-CLAVES.
003400************
           display "XPN-GRNBSDES-VER-CLAVES".
003410*
003420     MOVE   RUTDES-PAN             TO  WK-PAN.
003430     MOVE   K1U1                   TO  WK-INDICE.
003440     MOVE   ZERO                   TO  IND-ENCONTRADO.
003450     PERFORM BUSCA-BIN   THRU FIN-BUSCA-BIN
003460             UNTIL WK-ELEM-BIN ( WK-INDICE ) = HIGH-VALUES OR
003470                   ENCONTRADO.
003480     IF    ENCONTRADO
003490     THEN  NEXT SENTENCE
003500     ELSE  MOVE   WK-DEF-CLAVESMAES      TO  CLAVESMAES
003510           MOVE   WK-DEF-CLAVESNA        TO  CLAVESNA
003520           MOVE   WK-DEF-CLAVECSS        TO  CLAVECSS
003530           MOVE   WK-DEF-CLAVECVV1       TO  CLAVECVV1
003540           MOVE   WK-DEF-CLAVECVV2       TO  CLAVECVV2
003550           MOVE   WK-DEF-TABLADECMAES    TO  TABLADECMAES
003560           MOVE   WK-DEF-TABLADECNA      TO  TABLADECNA
003570           MOVE   WK-DEF-TABLADECCSS     TO  TABLADECCSS
003580           MOVE   WK-DEF-TABLADECCVV     TO  TABLADECCVV.
003590*
003600 FIN-VER-CLAVES.
003610****************
003620     EXIT.
003630*
003640*
003650*
003660 BUSCA-BIN.
003670***********
003680*
           display "XPN-GRNBSDES-BUSCA-BIN".

003690     IF    WK-ELEM-BIN ( WK-INDICE ) = WK-PAN-BIN
003700     THEN  MOVE  WK-PO-CLMA  (WK-INDICE)  TO   CLAVESMAES
003710           MOVE  WK-PO-CVV1  (WK-INDICE)  TO   CLAVECVV1
003720           MOVE  WK-PO-CVV2  (WK-INDICE)  TO   CLAVECVV2
003730           MOVE  WK-PO-CSS   (WK-INDICE)  TO   CLAVECSS
003740           MOVE  WK-PO-CNA   (WK-INDICE)  TO   CLAVESNA
003750           MOVE  WK-PO-TDEMA (WK-INDICE)  TO   TABLADECMAES
003760           MOVE  WK-PO-TDENA (WK-INDICE)  TO   TABLADECNA
003770           MOVE  WK-PO-TDECSS(WK-INDICE)  TO   TABLADECCSS
003780           MOVE  WK-PO-TDECVV(WK-INDICE)  TO   TABLADECCVV
003790           MOVE  K1U1                     TO   IND-ENCONTRADO
003800     ELSE  ADD   K1U1                     TO   WK-INDICE.
003810*
003820 FIN-BUSCA-BIN.
003830***************
003840     EXIT.
      *                                                                 CSSSGM
      *                                                                 CSSSGM
       BUSCAR-INDI-CLAVES.                                              CSSSGM
      ********************                                              CSSSGM
      *                                                                 CSSSGM
           display "XPN-GRNBSDES-INDI-CLAVES".

           MOVE  RUTDES-PAN       TO   WK-PAN.                          CSSSGM
           PERFORM LEER-TABINCLBIN THRU FIN-LEER-TABINCLBIN.            SAL92320
      *                                                                 CSSSGM
           IF    DLBUEN-ACCESO                                          CSSSGM
           THEN  MOVE  CLBIMAES             TO  CLAVESMAES              ID990913
                 MOVE  CLBINA               TO  CLAVESNA                ID990913
                 MOVE  CLBICSS              TO  CLAVECSS                ID990913
                 MOVE  CLBICVV1             TO  CLAVECVV1               ID990913
                 MOVE  CLBICVV2             TO  CLAVECVV2               ID990913
                 MOVE  CLBITDMA             TO  TABLADECMAES            ID990913
                 MOVE  CLBITDNA             TO  TABLADECNA              ID990913
JLCJLC     EXHIBIT NAMED 'BUSCAR-INDI-CLAVES 1' TABLADECNA CLBITDNA
                 MOVE  WK-DEF-TABLADECCSS   TO  TABLADECCSS             ID990913
                 MOVE  WK-DEF-TABLADECCVV   TO  TABLADECCVV             ID990913
                 MOVE  K1U1                 TO  DISPLA-ACC-TABINCLBIN   FANTASMA
           ELSE  MOVE  WK-DEF-CLAVESMAES    TO  CLAVESMAES              CSSSGM
                 MOVE  WK-DEF-CLAVESNA      TO  CLAVESNA                CSSSGM
                 MOVE  WK-DEF-CLAVECSS      TO  CLAVECSS                CSSSGM
                 MOVE  WK-DEF-CLAVECVV1     TO  CLAVECVV1               CSSSGM
                 MOVE  WK-DEF-CLAVECVV2     TO  CLAVECVV2               CSSSGM
                 MOVE  WK-DEF-TABLADECMAES  TO  TABLADECMAES            CSSSGM
JLCJLC     EXHIBIT NAMED 'BUSCAR-INDI-CLAVES 2' TABLADECNA 
JLCJLC        WK-DEF-TABLADECMAES
                 MOVE  WK-DEF-TABLADECNA    TO  TABLADECNA              CSSSGM
                 MOVE  WK-DEF-TABLADECCSS   TO  TABLADECCSS             CSSSGM
                 MOVE  WK-DEF-TABLADECCVV   TO  TABLADECCVV             FANTASMA
                 MOVE  ZERO                 TO  DISPLA-ACC-TABINCLBIN.  FANTASMA
      *                                                                 SAL92320
      ***L  POR SI SE MACHACA DE ALGUNA FORMA EL AREA DE WORKING        FANTASMA
      ***L  DONDE SE TIENE DEFINIDA EL VALOR DE LA POSICION             FANTASMA
      ***L  DE LA TABLA PARA CSS,  GUARDAMOS EL VALOR DE                FANTASMA
      ***L  WK-DEF-TABLADECCSS Y LE MOVEMOS SU VALOR DIRECTAMENTE       FANTASMA
      **    IGUAL PARA EL CVV.                                          FANTASMA
      *                                                                 FANTASMA
            MOVE   WK-DEF-TABLADECCSS       TO  DISPLA-DEF-TABLADECCSS. FANTASMA
            MOVE   WK-DEF-TABLADECCVV       TO  DISPLA-DEF-TABLADECCVV. FANTASMA
            MOVE   K1U3                     TO  TABLADECCSS.            FANTASMA
            MOVE   K1U3                     TO  TABLADECCVV.            FANTASMA
      *
           PERFORM LEER-TABINCLENT THRU FIN-LEER-TABINCLENT.            SAL92320
      *                                                                 SAL92320
           IF    DLBUEN-ACCESO                                          SAL92320
           THEN  MOVE  CLBECIFRA-PIN1    TO CLAVECIFRAPIN1
                 MOVE  CLBECIFRA-PIN2    TO CLAVECIFRAPIN2
                 MOVE  CLBETXPOR-ATM     TO CLAVETRANCAJ                SAL92320
                                            CLAVETRANSEP                SAL92320
                                            CLAVETRANADQ1               SAL92320
                                            CLAVETRANADQ2               SAL92320
                                            CLAVETRANEMI1               SAL92320
                                            CLAVETRANEMI2               SAL92320
           ELSE  MOVE  WK-DEF-CLAVECIFPIN1 TO CLAVECIFRAPIN1
                 MOVE  WK-DEF-CLAVECIFPIN2 TO CLAVECIFRAPIN2  
                 MOVE  WK-DEF-CLAVETRAN    TO CLAVETRANCAJ              SAL92320
                                              CLAVETRANSEP              SAL92320
                                              CLAVETRANADQ1             SAL92320
                                              CLAVETRANADQ2             SAL92320
                                              CLAVETRANEMI1             SAL92320
                                              CLAVETRANEMI2.            SAL92320
      *                                                                 CSSSGM
       FIN-BUSCAR-INDI-CLAVES.                                          CSSSGM
           EXIT.                                                        CSSSGM
003850*
003860*    FUNCION 8802
003870*            OBTENER NA A PARTIR DEL PAN
003880*
003890 CALCULO-NA.
003900************
003910*
           display "XPN-GRNBSDES-CALCULO-NA".

003920     MOVE    LOW-VALUES    TO  AREA-GRDESKEY.
003930     MOVE    RUTDES-PAN    TO  CADENA-DATOS.
003940     MOVE    CIFRAR        TO  OPERACION.
003950     MOVE    CLAVESNA      TO  INDICE-CLAVE.
003960     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
003970     MOVE    TABLADECNA    TO  INDICE-CLAVE-TD.
JLCJLC     EXHIBIT NAMED 'CALCULO-NA' TABLADECNA.
003980     MOVE    ALDESCID-OUT  TO  DATODECIM.
           DISPLAY 'CALCULO-NA. AREA-GRDESKEY-SALIDA: ' AREA-GRDESKEY.  JFL
           DISPLAY 'CALCULO-NA. AREA-GRGENTDE       : ' AREA-GRGENTDE.  JFL
003990     CALL    'GRINTTDE'    USING  AREA-GRGENTDE.
004000     MOVE  ALDESCID-OUT-TD TO  TABLA-DECIM.
004010     PERFORM DECIMALIZAR   THRU FIN-DECIMALIZAR
004020             VARYING INDICE FROM 1 BY 1 UNTIL INDICE = 17.
004030     MOVE    DATODECIM     TO  RUTDES-NA.
004040*
004050 FIN-CALCULO-NA.
004060****************
004070     EXIT.
004080*
004090*    CALCULO DE PA A PARTIR DE PAN Y OFFSET
004100*
004110 CALCULO-PA.
004120************
004130*
           display "XPN-GRNBSDES-CALCULO-PA".

004140     PERFORM CALCULO-NA    THRU FIN-CALCULO-NA.
004150     PERFORM CALCULO-PIN   THRU FIN-CALCULO-PIN.
004160     MOVE    RUTDES-PIN    TO   W-PA-PIN.
004170     MOVE    RUTDES-NA     TO   W-PA-NA.
004180     MOVE    LOW-VALUES    TO  AREA-GRDESKEY.
004190     MOVE    W-DATOS-PA    TO  CADENA-DATOS
004200                               CADENA-CLAVE.
004210     MOVE    CIFRAR        TO  OPERACION.
004220     MOVE    ZERO          TO  INDICE-CLAVE.
004230     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
004240     MOVE    ALDESCID-OUT  TO  RUTDES-PA.
004250*
004260 FIN-CALCULO-PA.
004270****************
004280     EXIT.
004290*
004300*
004310 CALCULO-PIN.
004320*************
004330*
           display "XPN-GRNBSDES-CALCULO-PIN".

004340     MOVE    LOW-VALUES    TO  AREA-GRDESKEY.
           DISPLAY 'GRNBSDES AREA-GRDESKEY-ENTRAD1: ' AREA-GRDESKEY '**'. 
004350     MOVE    RUTDES-PAN    TO  CADENA-DATOS.
           DISPLAY 'GRNBSDES AREA-GRDESKEY-ENTRAD2: ' AREA-GRDESKEY '**'. 
           DISPLAY 'GRNBSDES CADENA-DATOS: ' CADENA-DATOS.
004360     MOVE    CIFRAR        TO  OPERACION.
           DISPLAY 'GRNBSDES AREA-GRDESKEY-ENTRAD3: ' AREA-GRDESKEY '**'. 
           DISPLAY 'GRNBSDES OPERACION: ' OPERACION.
004370     MOVE    CLAVESMAES    TO  INDICE-CLAVE.
           DISPLAY 'GRNBSDES INDICE-CLAVE: ' INDICE-CLAVE.
           DISPLAY 'GRNBSDES AREA-GRDESKEY-ENTRADA: ' AREA-GRDESKEY '**'. 
004380     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
004390     MOVE    TABLADECMAES  TO  INDICE-CLAVE-TD.
           EXHIBIT NAMED 'CALCULO-PIN' TABLADECMAES.                    JFL
004400     MOVE    ALDESCID-OUT  TO  DATODECIM.
           DISPLAY 'CALCULO-PIN DATODECIM:' DATODECIM.
           DISPLAY 'CALCULO-PIN. AREA-GRDESKEY-SALIDA: ' AREA-GRDESKEY. JFL
           DISPLAY 'CALCULO-PIN. AREA-GRGENTDE: ' AREA-GRGENTDE.        JFL
004410*
004420     CALL    'GRINTTDE'    USING  AREA-GRGENTDE.
004430     MOVE  ALDESCID-OUT-TD TO  TABLA-DECIM.
004440     PERFORM DECIMALIZAR   THRU FIN-DECIMALIZAR
004450             VARYING INDICE FROM 1 BY 1 UNTIL INDICE > 16.
004460     MOVE    RUTDES-OFFSET TO  W-OFFSET.
004470     PERFORM SUMAR-OFFSET  THRU FIN-SUMAR-OFFSET
004480             VARYING INDICE FROM 1 BY 1 UNTIL INDICE > 4.
004490     MOVE    W-OFFSET      TO  RUTDES-PIN.
           DISPLAY 'CALCULO-PIN. RUTDES-PIN: ' RUTDES-PIN.              JFL
004500*
004510 FIN-CALCULO-PIN.
004520*****************
004530     EXIT.
004540*
004550*    CALCULO DE NUEVOS DATOS EN SUSTITUCION PARA CONSERVAR PIN
004560*
004570 CALCULO-NUE.
004580*************
004590*
           display "XPN-GRNBSDES-CALCULO-NUE".

004600     PERFORM CALCULO-PIN      THRU FIN-CALCULO-PIN.
LKMOVE*    MOVE    RUTDES-PAN       TO   W-GUARDPAN-VIEJO.
LKMOVE     MOVE RUTDES-PAN(1:) TO W-GUARDPAN-VIEJO(1:).
004620     MOVE    RUTDES-PAN-NUEVO TO   RUTDES-PAN.
004630     PERFORM CALCULO-NA       THRU FIN-CALCULO-NA.
004640     MOVE    W-GUARDPAN-VIEJO TO   RUTDES-PAN.
004650     MOVE    RUTDES-PIN       TO   W-PA-PIN.
004660     MOVE    RUTDES-NA        TO   W-PA-NA.
004670     MOVE    LOW-VALUES       TO  AREA-GRDESKEY.
004680     MOVE    W-DATOS-PA       TO  CADENA-DATOS
004690                                  CADENA-CLAVE.
004700     MOVE    CIFRAR           TO  OPERACION.
004710     MOVE    ZERO             TO  INDICE-CLAVE.
004720     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
004730     MOVE    ALDESCID-OUT     TO  RUTDES-PA.
004740     MOVE    LOW-VALUES       TO  AREA-GRDESKEY.
004750     MOVE    RUTDES-PAN-NUEVO TO  CADENA-DATOS.
004760     MOVE    CIFRAR           TO  OPERACION.
004770     MOVE    CLAVESMAES       TO  INDICE-CLAVE.
004780*
004790     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
004800*
004810     MOVE    TABLADECMAES     TO  INDICE-CLAVE-TD.
004820     MOVE    ALDESCID-OUT     TO  DATODECIM.
004830     CALL    'GRINTTDE'    USING  AREA-GRGENTDE.
004840     MOVE  ALDESCID-OUT-TD TO  TABLA-DECIM.
004850     PERFORM DECIMALIZAR      THRU FIN-DECIMALIZAR
004860             VARYING INDICE FROM 1 BY 1 UNTIL INDICE > 16.
004870     MOVE    RUTDES-PIN       TO  W-PIN.
004880     PERFORM RESTAR-PIN       THRU FIN-RESTAR-PIN
004890             VARYING INDICE FROM 1 BY 1 UNTIL INDICE > 4.
004900     MOVE    W-PIN            TO  RUTDES-OFF-NUEVO
004910                                  RUTDES-OFF-VIEJO.
004920     MOVE    W-GUARDPAN-VIEJO TO  RUTDES-PAN.
004930*
004940 FIN-CALCULO-NUE.
004950*****************
004960     EXIT.
004970*
004980*
004990 DECIMALIZAR.
005000*************
005010*
           display "XPN-GRNBSDES-DECIMALIZAR".

005020     MOVE  K2U1           TO  INDICE-TABLA.
005030     IF    ELEM-DATO ( INDICE ) IS NUMERIC
005040     THEN  MOVE ELEM-DATO ( INDICE ) TO W-AUX-NUME
005050           ADD W-AUX-NUME TO  INDICE-TABLA
005060           MOVE ELEM-TABLA ( INDICE-TABLA) TO ELEM-DATO ( INDICE )
005070     ELSE  MOVE ELEM-DATO ( INDICE ) TO ELEM-BINA
005080           SUBTRACT K1B17 FROM ELEM-BINA-N
005090           MOVE ELEM-BINA-2 TO  W-AUX-NUME
005100           ADD  K2U10       TO  INDICE-TABLA
005110           ADD  W-AUX-NUME  TO INDICE-TABLA
005120           MOVE ELEM-TABLA ( INDICE-TABLA )
005130                            TO ELEM-DATO ( INDICE ).
005140*
005150 FIN-DECIMALIZAR.
005160     EXIT.
005170*
005180*
005190 SUMAR-OFFSET.
005200**************
005210*
           display "XPN-GRNBSDES-SUMAR-OFFSET".

005220* ** ADD  ELEM-DATO-N ( INDICE ) TO  W-OFFSET-ELEM ( INDICE ).    SAL92320
      * POR PROBLEMAS DEL MICROFOCUS CON LOS ACARREOS, NO SE PUEDE      SAL92320
      * SUMAR DIRECTAMENTE UN NUMERICO DE 1 A OTRO NUMERICO DE 1.       SAL92320
005220     ADD  ELEM-DATO-N ( INDICE ) TO  W-OFFSET-ELEM ( INDICE )     SAL92320
                                   GIVING  WK-SUMA-2U.                  SAL92320
           MOVE  WK-SUMA-1U            TO  W-OFFSET-ELEM ( INDICE ).    SAL92320
005230*
005240 FIN-SUMAR-OFFSET.
005250******************
005260     EXIT.
005270*
005280*
005290 RESTAR-PIN.
005300************
005310*
           display "XPN-GRNBSDES-RESTAR-PIN".

005320     IF    ELEM-DATO-N ( INDICE ) > W-PIN-ELEM ( INDICE )
005330     THEN  MOVE W-PIN-ELEM ( INDICE ) TO W-AUX-2U
005340           ADD  K2U10                 TO W-AUX-2U
005350           SUBTRACT ELEM-DATO-N ( INDICE )  FROM W-AUX-2U
005360           MOVE W-AUX-2U              TO W-PIN-ELEM ( INDICE )
005370     ELSE  SUBTRACT ELEM-DATO-N ( INDICE )  FROM
005380                                   W-PIN-ELEM ( INDICE  ).
005390*
005400 FIN-RESTAR-PIN.
005410****************
005420     EXIT.
005430*
005440 VALIDAR-PIN-CAJ.
005450********************
005460*
           display "XPN-GRNBSDES-VALIDAR-PIN-CAJ".

005470     MOVE   CLAVETRANCAJ TO   WK-CLAVETRAN.
005480     PERFORM VAL-PINB THRU FIN-VAL-PINB.
005490*
005500 FIN-VALIDAR-PIN-CAJ.
005510*********************
005520     EXIT.
005530*
005540*    VALIDACION DE BLOQUE DE PIN
005550*
005560 VAL-PINB.
005570**********
005580*
           display "XPN-GRNBSDES-VAL-PINB".

005590     IF     DLPETIBLOPIN =  K1U1
005600     THEN   PERFORM VALPINB-1  THRU  FIN-VALPINB-1
005610     ELSE   IF    DLPETIBLOPIN = K1U3
005620            THEN  PERFORM VALPINB-3 THRU FIN-VALPINB-3
005630            ELSE  MOVE K4XERRPINB   TO  RUTDES-RESULT.
005640 FIN-VAL-PINB.
005650**************
005660     EXIT.
005670*
005680*    VALIDACION DE BLOQUE DE PIN FORMATO 1 (CAJEROS)
005690*
005700 VALPINB-1.
005710***********
005720*
           display "XPN-GRNBSDES-VALPINB-1".

005740     PERFORM CALCULO-PIN      THRU FIN-CALCULO-PIN.
005750*
005770     MOVE    ZEROES           TO  WK-BLOQ-PIN.
005780     MOVE    K1U4             TO  WK-BLOQ-PIN-L.
005790     MOVE    RUTDES-PIN       TO  WK-BLOQ-PIN-PIN.
005800     MOVE    HIGH-VALUES      TO  WK-BLOQ-PIN-FILLER.
005810     MOVE    WK-BLOQ-PIN      TO  WK-CHAR-16.
005830     MOVE    K1U1             TO  WK-INDICE.
005840     MOVE    K1U1             TO  WK-INDICE2.
005850     PERFORM COMPRIMIR        THRU FIN-COMPRIMIR
005860             8 TIMES.
005870     MOVE    WK-CHAR-8        TO  WK-BLOQ1-CSS.
005880     MOVE    ZEROES           TO  WK-BLOQ-PAN.
005890     MOVE    RUTDES-PAN       TO  WK-PAN.
005900     MOVE    WK-PAN-4-15      TO  WK-BLOQ-PAN-PAN.
005910     MOVE    WK-BLOQ-PAN      TO  WK-CHAR-16.
005920     MOVE    K1U1             TO  WK-INDICE.
005930     MOVE    K1U1             TO  WK-INDICE2.
005950     PERFORM COMPRIMIR        THRU FIN-COMPRIMIR
005960             8 TIMES.
005970     MOVE    WK-CHAR-8        TO  WK-BLOQ2-CSS.
005980     PERFORM HACER-XOR        THRU FIN-HACER-XOR.
005990     MOVE    WK-BLOQ2-CSS     TO  WK-CHAR-8.
006000     MOVE  K1U1         TO  WK-INDICE.
006010     MOVE  K1U1         TO  WK-INDICE2.
006020     PERFORM DESCOMPRIMIR THRU FIN-DESCOMPRIMIR
006030             8 TIMES.
006050     MOVE    LOW-VALUES       TO  AREA-GRDESKEY.
006060     MOVE    WK-CHAR-16       TO  CADENA-DATOS.
006070     MOVE    CIFRAR           TO  OPERACION.
006080     MOVE    WK-CLAVETRAN     TO  INDICE-CLAVE.
006090*
006100     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
006110     MOVE    ALDESCID-OUT     TO  WK-CHAR-16.
006120*
006140     IF    RUTDES-BPIN = WK-CHAR-16
006150     THEN  NEXT SENTENCE
006160     ELSE  MOVE  K4XNOK       TO  RUTDES-RESULT.
006170*
006180 FIN-VALPINB-1.
006190***************
006200     EXIT.
006210*
006220*    VALIDACION DE BLOQUE DE PIN FORMATO 3 (CAJEROS).
006230*
006240 VALPINB-3.
006250***********
006260*
           display "XPN-GRNBSDES-VALPINB-3".

006270     MOVE    LOW-VALUES       TO  AREA-GRDESKEY.
006280     MOVE    RUTDES-BPIN      TO  CADENA-DATOS.
006290     MOVE    DESCIFRAR        TO  OPERACION.
006300     MOVE    WK-CLAVETRAN     TO  INDICE-CLAVE.
006310     CALL    'GRINTDES'    USING  AREA-GRDESKEY.
006320     MOVE    ALDESCID-OUT     TO  WK-CHAR-16.
006330     PERFORM CALCULO-PIN      THRU FIN-CALCULO-PIN.
006340*
006350*   ATENCION, EN CAN VA A PARTIR DEL DIGITO 4 AUNQUE EN MANUAL DE
006360*   SEMP DICE QUE ES A PARTIR DEL 2.
006370*
006380     IF    RUTDES-PIN = WK-CHAR-16-4-4                            SAL92320
006390     THEN  NEXT SENTENCE
006400     ELSE  MOVE  K4XNOK       TO  RUTDES-RESULT.
006410*
006420 FIN-VALPINB-3.
006430***************
006440     EXIT.
006450*
006460*    RUTDES-II = 00 TRANSPORTE DE SEP
006470*    RUTDES-II = 01 TRANSPORTE DE PRICE CLAVE 1
006480*    RUTDES-II = 02 TRANSPORTE DE PRICE CLAVE 2
006490*
006500 VALIDAR-PIN-RED.
006510*****************
006520*
           display "XPN-GRNBSDES-VALIDAR-PIN-RED".

006530     IF    RUTDES-II = K2X01
006540     THEN  MOVE  CLAVETRANEMI1  TO WK-CLAVETRAN
