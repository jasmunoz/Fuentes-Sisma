###############################################################################################
### OBTENER LA FECHA DEL DIA EN EL FORMATO QUE SE GRABAN LOS NOMBRES DE LOS FICHEROS DE TRAZAS
###############################################################################################


#########################################
### MOVER TRAZAS DEL DIRECTORIO /TRAZAS
#########################################
cd $1/trazas
varDIA=`date +"%d%m%Y"`
echo $varDIA
ls | grep -v $varDIA | while read i
do
     echo $i
     mv $i $1/datos/trazas/$2
done

